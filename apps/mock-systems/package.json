{
  "name": "@orchestrador/mock-systems",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulators of every external system the Orquestador integrates with (CRM, ERP, planner, field tool, certificates, signature, document manager...). Used by docker compose and by the connector contract tests.",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "import": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./listen": {
      "types": "./src/listen.ts",
      "import": "./src/listen.ts",
      "default": "./src/listen.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@orchestrador/connector-sdk": "workspace:*",
    "hono": "^4.7.5",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
