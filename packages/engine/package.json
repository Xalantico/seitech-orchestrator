{
  "name": "@orchestrador/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure flow interpreter. No Node, DB or Temporal imports: it runs inside the Temporal workflow sandbox and in unit tests.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orchestrador/shared": "workspace:*",
    "@orchestrador/rules": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
