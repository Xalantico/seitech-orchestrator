{
  "name": "@orchestrador/connectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adapters for the systems the Orquestador talks to: CRM, ERP, qualifications, planner, field tool, timesheets, batch files, certificates, forms, digital signature, communications, document manager, CAE, customer portal, Microsoft 365 and SQL Server.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orchestrador/connector-sdk": "workspace:*",
    "@orchestrador/flowhost": "workspace:*",
    "@orchestrador/db": "workspace:*",
    "@orchestrador/platform": "workspace:*",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@orchestrador/mock-systems": "workspace:*",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
