{
  "name": "@orchestrador/comms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Channel dispatcher (email, SMS, WhatsApp, push, internal) with retries and per-channel rate limits, plus template helpers. Shared by the API and the worker.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orchestrador/db": "workspace:*",
    "@orchestrador/observability": "workspace:*",
    "@orchestrador/platform": "workspace:*",
    "@orchestrador/shared": "workspace:*",
    "mjml": "^4.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "pg": "^8.14.1",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
