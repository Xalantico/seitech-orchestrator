{
  "name": "@orchestrador/flowhost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starts and controls flow executions, runs state transitions, dispatches domain events and schedules. Shared by the API and the worker.",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orchestrador/db": "workspace:*",
    "@orchestrador/engine": "workspace:*",
    "@orchestrador/observability": "workspace:*",
    "@orchestrador/rules": "workspace:*",
    "@orchestrador/shared": "workspace:*",
    "@temporalio/client": "1.23.0",
    "cron-parser": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "pg": "^8.14.1",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
