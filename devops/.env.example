# Generated by `make init` (scripts/init-env.sh) into devops/.env with random secrets. Never commit .env.
COMPOSE_PROJECT_NAME=orquestador
DOMAIN=orquestador.localhost
HTTPS_PORT=8443
HTTP_PORT=8088
APP_ENV=dev
GIT_SHA=local

# ── Optional: BI embedding. `make bi-bootstrap` fills these in after Metabase is up.
# METABASE_SITE_URL=https://bi.orquestador.localhost:8443
# METABASE_DASHBOARDS=1:Operaciones,2:Visitas,3:Calidad y facturación
# ── Optional: copilot language model (any OpenAI-compatible API). Without it the copilot answers by retrieval only.
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# RETENTION_OPERATIONAL_YEARS=5
